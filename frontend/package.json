  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.4.6"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.34.9",
